# Copy this to .env in the project root and fill in real values before running
# `docker compose up --build`.

# --- database ---
DATABASE_NAME=commhub
DATABASE_USERNAME=commhub
DATABASE_PASSWORD=commhub
MYSQL_ROOT_PASSWORD=changeme

# --- backend auth ---
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Comma-separated origins allowed to call the API - include wherever the
# frontend container/browser is actually served from.
CORS_ORIGINS=http://localhost:5173

# --- LimeSurvey (optional - leave blank if not using survey support yet) ---
LIMESURVEY_RPC_URL=
LIMESURVEY_PUBLIC_URL=
LIMESURVEY_USERNAME=
LIMESURVEY_PASSWORD=

# --- frontend ---
# URL the browser calls - defaults to the backend's published host port.
VITE_API_BASE_URL=http://localhost:8000
